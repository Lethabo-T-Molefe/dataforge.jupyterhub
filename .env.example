# Copy to .env. Every setting also reads from the environment.

# Single sign-on from DataForge. Must match SSO_SHARED_SECRET and JWT_ISSUER in the API's settings.
SSO_SHARED_SECRET=replace-with-the-api-sso-secret
DATAFORGE_JWT_ISSUER=dataforge

# The token the DataForge API uses to save notebooks here. Must match JUPYTER_API_TOKEN in the API's settings.
JUPYTER_API_TOKEN=replace-with-a-long-random-token

# Where notebook kernels reach the DataForge API (no /api/v1 suffix).
DATAFORGE_API_URL=http://localhost:8000

# Origins allowed to frame JupyterLab (the DataForge web app), comma-separated.
DATAFORGE_FRONTEND_ORIGINS=http://localhost:8080,http://localhost:5173

# The port to listen on. Leave unset on a host that assigns PORT (Render).
JUPYTER_PORT=8888

# Optional: where notebooks are stored (defaults to ./workspace; the container uses /workspace).
# JUPYTER_WORKSPACE=/srv/dataforge/notebooks
